<?xml version="1.0"?>
<!-- Training-only preflight: verifies that a semantic segmentation camera can
     render with exactly the same custom wide-angle lens declaration as the
     raw-fisheye RGB cameras.  It is not a competition world or runtime input. -->
<sdf version="1.9">
  <world name="fisheye_segmentation_preflight">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><direction>-0.2 0.1 -1</direction></light>
    <model name="labelled_box">
      <pose>5 0 0.5 0 0 0</pose><static>true</static>
      <link name="link"><visual name="visual"><geometry><box><size>1 1 1</size></box></geometry></visual></link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>1</label></plugin>
    </model>
    <model name="camera_rig">
      <static>true</static><link name="link">
        <sensor name="raw_fisheye_rgb" type="wide_angle_camera">
          <topic>/preflight/rgb</topic><always_on>1</always_on><update_rate>5</update_rate>
          <camera><horizontal_fov>3.054</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>200</far></clip><lens><type>custom</type><custom_function><c1>1.05</c1><c2>4</c2><f>1.0</f><fun>tan</fun></custom_function><scale_to_hfov>true</scale_to_hfov><env_texture_size>2048</env_texture_size></lens>
            <save enabled="true"><path>preflight_rgb</path></save>
          </camera>
        </sensor>
        <sensor name="raw_fisheye_semantic" type="segmentation">
          <topic>/preflight/semantic</topic><always_on>1</always_on><update_rate>5</update_rate>
          <camera><segmentation_type>semantic</segmentation_type><horizontal_fov>3.054</horizontal_fov><image><width>1280</width><height>720</height></image>
            <clip><near>0.05</near><far>200</far></clip><lens><type>custom</type><custom_function><c1>1.05</c1><c2>4</c2><f>1.0</f><fun>tan</fun></custom_function><scale_to_hfov>true</scale_to_hfov><env_texture_size>2048</env_texture_size></lens>
            <save enabled="true"><path>preflight_semantic</path></save>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
