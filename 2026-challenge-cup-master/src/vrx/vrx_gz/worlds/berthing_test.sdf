    <!-- ====== 浮标: 起航区 (WAM-V周围, ~[-710,350]) ====== -->
    <include><name>b_start_0</name><pose>-710 375 0 0 0 0</pose><uri>https://fuel.gazebosim.org/1.0/openrobotics/models/mb_marker_buoy_red</uri>
